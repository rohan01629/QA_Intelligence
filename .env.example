# Azure DevOps
ADO_ORGANIZATION=
ADO_PROJECT=
ADO_BASE_URL=https://dev.azure.com
ADO_API_VERSION=7.1
ADO_PAT=

# Optional Test Plan / Suite placement
ADO_DEFAULT_TEST_PLAN_ID=
ADO_DEFAULT_SUITE_ID=

# Work item type / field overrides
ADO_USER_STORY_TYPE=User Story
ADO_TEST_CASE_TYPE=Test Case
ADO_BUG_TYPE=Bug
ADO_AC_FIELD=Microsoft.VSTS.Common.AcceptanceCriteria
ADO_TESTED_BY_RELATION=Microsoft.VSTS.Common.TestedBy-Forward

# MCP / server
MCP_TRANSPORT=stdio
LOG_LEVEL=INFO

# HTTP client
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# QA Intelligence behavior
DUPLICATE_THRESHOLD=0.82
CREATE_REJECT_DUPLICATES=true
