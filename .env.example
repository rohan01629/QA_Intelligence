# Azure DevOps
ADO_ORGANIZATION=
ADO_PROJECT=
ADO_BASE_URL=https://dev.azure.com
ADO_API_VERSION=7.1
ADO_PAT=

# Optional Test Plan / Suite placement
ADO_DEFAULT_TEST_PLAN_ID=
ADO_DEFAULT_SUITE_ID=

# Work item type / field overrides
ADO_USER_STORY_TYPE=User Story
ADO_TEST_CASE_TYPE=Test Case
ADO_BUG_TYPE=Bug
ADO_AC_FIELD=Microsoft.VSTS.Common.AcceptanceCriteria
ADO_TESTED_BY_RELATION=Microsoft.VSTS.Common.TestedBy-Forward
# Rule 13 ADO Custom toggles (Critical → Sanity)
ADO_IS_REGRESSION_FIELD=Custom.IsRegression
ADO_SANITY_FIELD=Custom.Sanity

# QA Intelligence behavior
DUPLICATE_THRESHOLD=0.82
CREATE_REJECT_DUPLICATES=true

# Safety: work-item creates/links are OFF unless explicitly enabled
ADO_WRITES_ENABLED=false

# Generation volume (Rule 11) — simple ~25; complex only → 50–60
MIN_GENERATED_TEST_CASES=25
TARGET_COMPLEX_TEST_CASES=50
MAX_GENERATED_TEST_CASES=60

# Code Intelligence — optional Azure Repos defaults (Code Read on PAT; never Code Write)
ADO_DEFAULT_GIT_REPOSITORY=
ADO_DEFAULT_GIT_BRANCH=main-uat
# CODE_INTEL_CACHE_DIR=   # optional; default ~/.cache/qa_intelligence/ado_git

# Local app trees for Code Intelligence (comma-separated; story picks best match).
# Set real paths only in your private .env (never commit machine-specific paths).
# QA-state Live+ User Stories auto-map UAT folder names to QA (e.g. Live_Plus_UAT → Live_Plus_QA).
CODE_INTEL_LOCAL_REPOSITORY_PATHS=

# MCP / server
MCP_TRANSPORT=stdio
LOG_LEVEL=INFO

# HTTP client
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
